# Copy this file to .env and adjust the values. Never commit .env.
NODE_ENV=development
PORT=5000

# Local MongoDB Community Server (free, runs on your laptop)
MONGODB_URI=mongodb://127.0.0.1:27017/airbnb_soa

# Used only by `npm test`. Must be a separate database: the tests wipe it.
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/airbnb_soa_test

# Comma-separated list of frontend origins allowed by CORS.
# Use * only for quick local experiments, never in production.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
